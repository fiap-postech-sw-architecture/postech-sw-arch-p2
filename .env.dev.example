# Exemplo de variaveis de ambiente para desenvolvimento local.
# Copie para .env.dev (ignorado pelo git) e ajuste conforme necessario.
# Usado por docker-compose (env_file) e por scripts/run-dev.sh (source).
# Unico destino evita drift entre container e execucao local.

# Credenciais do PostgreSQL.
POSTGRES_DB=pytstop
POSTGRES_USER=pytstop
POSTGRES_PASSWORD=pytstop

# Conexao com Postgres.
# Para rodar via docker compose, use o nome do servico: postgres
# Para rodar localmente (fora do docker), use: localhost
DATABASE_URL=postgresql://pytstop:pytstop@postgres:5432/pytstop

# JWT HS256 requer chave com pelo menos 32 bytes.
JWT_SECRET=dev-secret-change-me-this-is-at-least-32-bytes-long-for-hs256
JWT_EXPIRATION_MINUTES=30

# Ambiente determina docs/redoc urls e outros defaults.
ENVIRONMENT=development

# Origens permitidas no CORS (separadas por virgula, sem espacos).
CORS_ORIGINS=http://localhost:3000

# Porta do uvicorn (default: 8001 para nao colidir com docker compose na 8000).
UVICORN_PORT=8001

# Portas do host expostas pelo docker-compose. Defaults usados quando ausente:
# APP_PORT=8000, DB_PORT=5432, UI_PORT=8080. Sobrescreva quando rodar
# multiplos worktrees em paralelo (cada worktree precisa de portas distintas
# no host -- as portas internas do container nao mudam). Exemplo para o
# worktree slot 2: APP_PORT=8002, DB_PORT=5433, UI_PORT=8081. Veja
# docs/setup/worktrees-paralelos.md para a tabela de slots sugerida.
# APP_PORT=8000
# DB_PORT=5432
# UI_PORT=8080

# URL que o seed_demo.py e a UI local usam para chamar o backend. Se voce
# alterou APP_PORT acima, ajuste aqui tambem (env files nao expandem variaveis).
# Default no seed_demo.py: http://localhost:8000.
# BACKEND_URL=http://localhost:8000

# Credenciais do admin inicial - usadas por scripts/seed_admin.py.
# ADMIN_EMAIL: email do admin (normalizado para lowercase).
# ADMIN_PASSWORD: >= 12 chars, sem placeholders publicos conhecidos.
# Deixe em branco aqui para forcar o dev a preencher antes de habilitar o seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Controla execucao automatica no startup do container.
# RUN_MIGRATIONS_ON_STARTUP: aplica alembic upgrade head.
# RUN_SEED_ON_STARTUP: cria admin inicial (exige ADMIN_EMAIL/ADMIN_PASSWORD).
# Default do seed e 'false' para evitar admin com credencial publica por engano.
RUN_MIGRATIONS_ON_STARTUP=true
RUN_SEED_ON_STARTUP=false

# Chave Fernet (base64 url-safe 32 bytes) para criptografar PII (documento do
# cliente) em repouso. Se ausente, o app gera efemera em memoria — o que quebra
# entre restarts do container (ciphertexts antigos nao decifram). EM PRODUCAO
# ou em testes com persistencia (docker compose up sem --force-recreate),
# defina uma chave estavel. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Valor abaixo e DEV-ONLY: basta ser estavel entre restarts; nunca use em prod.
ENCRYPTION_KEY=o2PanCXdqDQ87JA2AOA1oNazx5bGwSdUZrHY1rvHnx0=

# Notificacao de status por e-mail (RF-024 / ADR-018). No docker compose o
# servidor e o servico mailpit (SMTP interno na 1025; UI web em
# http://localhost:8025). Rodando local (fora do docker), use
# SMTP_HOST=localhost — sem servidor SMTP no ar o envio falha, e logado e
# NUNCA bloqueia a transicao de status. Credenciais de um relay real ficam
# fora da fase 2 (entrariam por Secret no cluster, RNF-020).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=oficina@pytstop.local

# Token estatico do canal externo de decisao de orcamento (RF-022 / ADR-021).
# Autentica o header X-Webhook-Token de
# POST /api/v1/publico/ordens-de-servico/{id}/decisao-orcamento.
# Vazio ou ausente = canal externo desabilitado (endpoint responde 503).
# Valor abaixo e DEV-ONLY; no cluster a variavel entra por Secret (RFC-002 §6).
ORCAMENTO_WEBHOOK_TOKEN=demo-webhook-orcamento-nao-usar-em-producao

# Traces OpenTelemetry (diferencial ADR-020). Default OFF: a instrumentacao
# (FastAPI + SQLAlchemy -> OTLP/gRPC -> Jaeger) so liga com OTEL_ENABLED=true
# E o extra instalado (`uv sync --extra otel`; a imagem Docker ja inclui).
# Flag ligada sem o extra = warning no log e boot normal, sem traces.
# No compose, suba o backend de traces com o profile dedicado:
#   OTEL_ENABLED=true docker compose --profile otel up -d
# Jaeger UI: http://localhost:16686 (porta do host via JAEGER_UI_PORT).
# Rodando local (fora do docker), aponte o endpoint para a porta publicada:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
