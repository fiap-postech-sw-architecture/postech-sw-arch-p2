# Exemplo de variaveis de ambiente para desenvolvimento local.
# Copie para .env.dev (ignorado pelo git) e ajuste conforme necessario.
# Usado por docker-compose (env_file) e por scripts/run-dev.sh (source).
# Unico destino evita drift entre container e execucao local.

# Credenciais do PostgreSQL.
POSTGRES_DB=pytstop
POSTGRES_USER=pytstop
POSTGRES_PASSWORD=pytstop

# Conexao com Postgres.
# Para rodar via docker compose, use o nome do servico: postgres
# Para rodar localmente (fora do docker), use: localhost
DATABASE_URL=postgresql://pytstop:pytstop@postgres:5432/pytstop

# JWT HS256 requer chave com pelo menos 32 bytes.
JWT_SECRET=dev-secret-change-me-this-is-at-least-32-bytes-long-for-hs256
JWT_EXPIRATION_MINUTES=30

# Ambiente determina docs/redoc urls e outros defaults.
ENVIRONMENT=development

# Origens permitidas no CORS (separadas por virgula, sem espacos).
CORS_ORIGINS=http://localhost:3000

# Porta do uvicorn (default: 8001 para nao colidir com docker compose na 8000).
UVICORN_PORT=8001

# Credenciais do admin inicial - usadas por scripts/seed_admin.py.
# ADMIN_EMAIL: email do admin (normalizado para lowercase).
# ADMIN_PASSWORD: >= 12 chars, sem placeholders publicos conhecidos.
# Deixe em branco aqui para forcar o dev a preencher antes de habilitar o seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Controla execucao automatica no startup do container.
# RUN_MIGRATIONS_ON_STARTUP: aplica alembic upgrade head.
# RUN_SEED_ON_STARTUP: cria admin inicial (exige ADMIN_EMAIL/ADMIN_PASSWORD).
# Default do seed e 'false' para evitar admin com credencial publica por engano.
RUN_MIGRATIONS_ON_STARTUP=true
RUN_SEED_ON_STARTUP=false

# Chave Fernet (base64 url-safe 32 bytes) para criptografar PII (documento do
# cliente) em repouso. Se ausente, o app gera efemera em memoria — o que quebra
# entre restarts do container (ciphertexts antigos nao decifram). EM PRODUCAO
# ou em testes com persistencia (docker compose up sem --force-recreate),
# defina uma chave estavel. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Valor abaixo e DEV-ONLY: basta ser estavel entre restarts; nunca use em prod.
ENCRYPTION_KEY=o2PanCXdqDQ87JA2AOA1oNazx5bGwSdUZrHY1rvHnx0=
