# URL de base da API (instancia viva do docker compose up).
FULL_TEST_BASE_URL=http://localhost:8000

# URL do PostgreSQL usada pelos seeders de usuarios (bypass da API).
# Deve bater com o container do docker-compose.yml (porta 5432 exposta em 127.0.0.1).
FULL_TEST_DATABASE_URL=postgresql://pytstop:pytstop@localhost:5432/pytstop

# Credenciais do admin seed (bate com scripts/seed_admin.py no container).
# NOTA: pydantic EmailStr rejeita TLDs reservados (RFC 6761) como .local, .test.
# Usar .dev (ou um dominio real em ambientes reais).
FULL_TEST_ADMIN_EMAIL=full-test-admin@pytstop.dev
FULL_TEST_ADMIN_PASSWORD=ChangeMeStrong123!

# Numero de threads por persona no orchestrator (step 9).
FULL_TEST_N_CLIENTES=4
FULL_TEST_N_OPERADORES=2
FULL_TEST_N_ADMINS=1

# Timeout HTTP em segundos (SystemClient).
FULL_TEST_HTTP_TIMEOUT=30

# Semente do random para reproducibilidade dos dados sinteticos (None = clock).
FULL_TEST_SEED=20260422

# RF-022: token do canal externo de decisao de orcamento (webhook).
# DEVE bater com o ORCAMENTO_WEBHOOK_TOKEN do container app (docker-compose.yml,
# servico `app`); o default abaixo espelha o default de demo do compose para que
# os runs locais batam sem configuracao extra. Token vazio => o endpoint
# /publico/.../decisao-orcamento responde 503 (canal desativado).
ORCAMENTO_WEBHOOK_TOKEN=demo-webhook-orcamento-nao-usar-em-producao
