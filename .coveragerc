# .coveragerc
# Thresholds por path. `src/` mantem 95% (meta oficial do backend);
# `ui/` fica em 95% tambem — modulos puros (config/estado/cliente_api/seed/
# auth_guard) sao unit-testaveis sem NiceGUI, so pages/componentes/app.py
# precisam de E2E (excluidos do gate abaixo). A separacao e enforcada
# via dois `pytest --cov` distintos (ver Makefile e .github/workflows/ci.yml).

[run]
relative_files = True
# O gate cobre SO codigo de produto (src, ui). Scripts utilitarios de build
# fora dessas arvores — ex.: .claude/skills/entrega-tech-challenge/scripts/
# gerar_pdf_entrega.py — tem testes proprios (tests/unitarios/scripts/, pegam
# regressao) mas ficam de fora deste gate de 95% por nao serem produto.
source = src, ui
omit =
    tests/*
    */migrations/*
    */__init__.py
    # Ports de dominio sao Protocols PUROS (interfaces sem logica): linha de
    # Protocol so "cobre" via import, e o unico teste que os importava era um
    # hasattr vacuo (removido no #173). 4 dos 5 ja estavam em 0% com o gate
    # verde; excluir todos torna o gate honesto em vez de premiar import morto.
    src/*/dominio/repository.py
    # UI render modules ficam fora do gate unitario: a cobertura real deles e
    # 1 teste Screen lento (opt-in `-m lento`, ver tests/unitarios/ui) + as
    # jornadas MANUAIS documentadas em tests/e2e_ui/jornadas.md. Nao ha suite
    # Playwright automatizada.
    ui/paginas/*
    ui/componentes/*
    ui/app.py
    ui/__main__.py

[paths]
src = src/
ui = ui/

[report]
# Meta global: 95% no backend. UI tem meta de 95% tambem (gate em
# `pytest --cov=ui --cov-fail-under=95`, ver CI).
fail_under = 95
show_missing = True
